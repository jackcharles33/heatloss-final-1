# UK Government EPC API Bearer token
# Get yours at: https://epc.opendatacommunities.org/
# Must be set in Vercel dashboard under Project Settings > Environment Variables
EPC_API_KEY=your-epc-api-key-here

# Supabase (optional — for server-side calculation persistence)
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key